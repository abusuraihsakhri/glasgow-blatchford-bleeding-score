{
  "openapi": "3.1.0",
  "info": {
    "title": "Glasgow Blatchford Bleeding Score API",
    "description": "Pre-endoscopy GBS calculator with separate legacy demonstration endpoints. The clinical score is not a mortality prediction.",
    "version": "4.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Service process available"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Legacy supervisor counters (JSON)",
        "responses": {
          "200": {
            "description": "JSON counts for the demonstration supervisor"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate a demonstration supervisor task (not clinical GBS)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Query deterministic demonstration supervisor",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/gbs": {
      "post": {
        "summary": "Calculate Glasgow–Blatchford Score from complete clinical inputs",
        "description": "GBS 0–1 is a very-low-risk group; disposition still requires clinical judgment. Does not predict individual mortality.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "bun_mmol_l": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Blood urea mmol/L; not BUN mg/dL"
                  },
                  "hemoglobin_g_dl": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 30
                  },
                  "sex": {
                    "type": "string",
                    "enum": [
                      "male",
                      "female"
                    ]
                  },
                  "sbp_mmhg": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 300
                  },
                  "heart_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 300
                  },
                  "melena": {
                    "type": "boolean"
                  },
                  "syncope": {
                    "type": "boolean"
                  },
                  "hepatic_disease": {
                    "type": "boolean"
                  },
                  "cardiac_failure": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "bun_mmol_l",
                  "hemoglobin_g_dl",
                  "sex",
                  "sbp_mmhg",
                  "heart_rate",
                  "melena",
                  "syncope",
                  "hepatic_disease",
                  "cardiac_failure"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "GBS score with component points, completeness and risk interpretation"
          },
          "422": {
            "description": "Required field missing or invalid"
          }
        }
      }
    }
  }
}
